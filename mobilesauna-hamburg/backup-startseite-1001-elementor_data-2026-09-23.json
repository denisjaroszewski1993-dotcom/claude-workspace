        "id": "3de6eb0",
        "elType": "widget",
        "settings": {
         "title": "Ihr mobiles Wellness-Erlebnis: Sauna und Whirlpool mieten",
         "header_size": "h2",
         "_css_classes": "msh-title-line"
        },
        "elements": [],
