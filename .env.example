# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Meta WhatsApp Business Cloud API
# Aus dem Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret aus Meta App Dashboard -> Einstellungen -> Basis (fuer Signaturpruefung der Webhooks)
WHATSAPP_APP_SECRET=
# Frei waehlbarer String, den du beim Einrichten des Webhooks in Meta ebenfalls eintraegst
WHATSAPP_VERIFY_TOKEN=change-me

# Optionales System-Prompt fuer Claude
SYSTEM_PROMPT="Du bist ein hilfreicher WhatsApp-Assistent."

# Port des lokalen Servers
PORT=3000
